{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FriendsTableOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Query",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/bdayapp-friends"
    },
    {
      "Sid": "SendRemindersFromVerifiedAddresses",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "ses:FromAddress": "FROM_ADDRESS" }
      }
    }
  ]
}
