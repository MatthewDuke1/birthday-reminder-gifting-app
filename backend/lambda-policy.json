{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FriendsTableOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Query",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/bdayapp-friends"
    },
    {
      "Sid": "AppSecretsOnly",
      "Effect": "Allow",
      "Action": "ssm:GetParameters",
      "Resource": [
        "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/bdayapp/password-hash",
        "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/bdayapp/jwt-secret"
      ]
    },
    {
      "Sid": "DecryptSsmSecureStrings",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "kms:ViaService": "ssm.REGION.amazonaws.com" }
      }
    },
    {
      "Sid": "SendRemindersFromVerifiedAddresses",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "ses:FromAddress": "FROM_ADDRESS" }
      }
    }
  ]
}
